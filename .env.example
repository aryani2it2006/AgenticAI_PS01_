# ==============================================================================
# SyncSoul AI — Advanced Task Management & Intelligent Follow-up System
# Configuration & Environment Variables
# ==============================================================================

# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: LLM Task Understanding & Blocker Analysis (Anthropic Claude API)
# If left empty, SyncSoul AI uses its comprehensive built-in multilingual rule engine (English + Hindi + Hinglish)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: Web Dashboard Settings
HOST=0.0.0.0
PORT=8080

# Optional: Default Timezone for Deadline Tracking & Overdue Calculations
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional: Automated Follow-up Scheduler Interval (in minutes, 0 = manual only)
# When set > 0, the scheduler periodically checks overdue/stalled tasks and sends smart nudges
CHECKIN_INTERVAL_MIN=0

# Optional: SQLite Database Path (defaults to ./data/coordinator.db)
# DB_PATH=./data/coordinator.db
